#!/bin/sh

os=$(uname -s)

# macOS
if [ "$os" = "Darwin" ]; then
  if [ -t 0 ]; then
    exec pbpaste
  else
    exec pbcopy
  fi
fi

# Wayland (Linux)
if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
  if command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
    if [ -t 0 ]; then
      exec wl-paste
    else
      exec wl-copy
    fi
  fi
  echo "wl-clipboard is not installed. Please install it to use clipboard operations on Wayland." >&2
  exit 1
fi

# X11 / OpenBSD fallback
if ! command -v xclip >/dev/null 2>&1; then
  echo "xclip is not installed. Please install it to use clipboard operations on Linux/BSD." >&2
  exit 1
fi

if [ -t 0 ]; then
  exec xclip -selection clipboard -o
else
  exec xclip -selection clipboard -i
fi
